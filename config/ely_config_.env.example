// secure_api_client.ts
import { SECRET_KEY, API_TOKEN } from "./config"
import { z } from "zod"

/**
 * interface for the shape of the API response
 */
export interface SecureDataResponse {
  data: Record<string, unknown>
  timestamp: string
}

/**
 * strict runtime schema validation
 * timestamp must be ISO-8601 and not in the future
 */
const SecureDataResponseSchema = z
  .object({
    data: z.record(z.unknown()),
    timestamp: z
      .string()
      .refine((s) => !Number.isNaN(Date.parse(s)), "timestamp must be ISO-8601"),
  })
  .refine((val) => Date.parse(val.timestamp) <= Date.now(), "timestamp cannot be in the future")

/**
 * optional error payload some backends return on non 2xx
 */
const ErrorPayloadSchema = z.object({
  error: z
    .object({
      code: z.string().optional(),
      message: z.string().optional(),
    })
    .partial(),
}).partial()

export type ErrorPayload = z.infer<typeof ErrorPayloadSchema>

/**
 * options for fetching from the secure API
 */
export interface FetchSecureDataOptions {
  baseUrl?: string               // defaults to https://api.alyssium.ai
  path?: string                  // defaults to /data
  method?: "GET" | "POST"        // defaults to GET
  query?: Record<string, string | number | boolean | null | undefined> // optional query params
  body?: unknown                 // JSON body for POST
  timeoutMs?: number             // per attempt timeout in ms, default 10_000
  retries?: number               // number of retries on 429/5xx and network timeouts, default 2
  backoffMs?: number             // deterministic linear backoff base, default 500
  signal?: AbortSignal           // optional external abort signal
  extraHeaders?: Record<string, string> // extra headers merged after auth headers
  expectedSchema?: z.ZodTypeAny  // override schema for custom endpoints if needed
}

/**
 * typed error for better handling upstream
 */
export class SecureApiError extends Error {
  readonly status?: number
  readonly payload?: ErrorPayload | string
  constructor(message: string, status?: number, payload?: ErrorPayload | string) {
    super(message)
    this.name = "SecureApiError"
    this.status = status
    this.payload = payload
  }
}

/**
 * fetch JSON from the secure API with timeout, retries, query building and schema validation
 * no randomness is used
 */
export async function fetchSecureData(opts: FetchSecureDataOptions = {}): Promise<SecureDataResponse> {
  const {
    baseUrl = "https://api.alyssium.ai",
    path = "/data",
    method = "GET",
    query,
    body,
    timeoutMs = 10_000,
    retries = 2,
    backoffMs = 500,
    signal: externalSignal,
    extraHeaders = {},
    expectedSchema = SecureDataResponseSchema,
  } = opts

  const url = buildUrl(baseUrl, path, query)

  // deterministic retry loop
  let lastErr: unknown
  for (let attempt = 0; attempt <= retries; attempt++) {
    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs)

    const onAbort = () => controller.abort()
    externalSignal?.addEventListener("abort", onAbort, { once: true })

    try {
      const res = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
          "X-API-TOKEN": API_TOKEN,
          "X-SECRET-KEY": SECRET_KEY,
          "X-Client": "secure_api_client",
          ...extraHeaders,
        },
        body: method === "POST" ? JSON.stringify(body ?? {}) : undefined,
        signal: controller.signal,
      })

      // retry on 429 and 5xx
      if (res.status === 429 || (res.status >= 500 && res.status <= 599)) {
        lastErr = new SecureApiError(`upstream error ${res.status}`, res.status, await safePayload(res))
        if (attempt < retries) {
          const retryAfterMs = boundedRetryAfterMs(res, backoffMs * (attempt + 1))
          await delay(retryAfterMs)
          continue
        }
        throw lastErr
      }

      if (!res.ok) {
        const payload = await safePayload(res)
        const display = typeof payload === "string" ? safeText(payload) : JSON.stringify(payload)
        throw new SecureApiError(`api error ${res.status}: ${display}`, res.status, payload)
      }

      const ct = (res.headers.get("content-type") || "").toLowerCase()
      if (!ct.includes("application/json")) {
        throw new SecureApiError(`unexpected content-type ${ct || "unknown"}`)
      }

      const json = (await res.json()) as unknown
      const parsed = expectedSchema.parse(json) as SecureDataResponse
      return parsed
    } catch (err: any) {
      const isAbort = err?.name === "AbortError"
      lastErr = isAbort ? new SecureApiError(`request timed out after ${timeoutMs}ms`) : err

      // retries only for network like errors and timeouts
      if (attempt < retries && (isAbort || isNetworkLikeError(err))) {
        await delay(backoffMs * (attempt + 1))
        continue
      }
      throw lastErr
    } finally {
      clearTimeout(timeoutId)
      externalSignal?.removeEventListener("abort", onAbort)
    }
  }

  // should never reach here
  throw lastErr ?? new SecureApiError("unknown error")
}

/**
 * helper to build a URL with query params safely
 */
function buildUrl(baseUrl: string, path: string, query?: FetchSecureDataOptions["query"]): string {
  const u = new URL(path, normalizeBase(baseUrl))
  if (query) {
    const sp = new URLSearchParams()
    for (const [k, v] of Object.entries(query)) {
      if (v === null || typeof v === "undefined") continue
      sp.append(k, String(v))
    }
    const qs = sp.toString()
    if (qs) u.search = qs
  }
  return u.toString()
}

/**
 * normalize base url so URL() treats it consistently
 */
function normalizeBase(baseUrl: string): string {
  // ensure trailing slash is present once
  return baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`
}

/**
 * parse a conservative Retry-After header in seconds and bound it
 * defaultBackoffMs is used if header is missing or invalid
 */
function boundedRetryAfterMs(res: Response, defaultBackoffMs: number): number {
  const hdr = res.headers.get("retry-after")
  if (!hdr) return defaultBackoffMs
  const asInt = Number.parseInt(hdr, 10)
  if (Number.isFinite(asInt) && asInt >= 0) {
    // clamp to a reasonable ceiling to avoid long stalls
    const ms = asInt * 1000
    return ms > 30_000 ? 30_000 : ms
  }
  // ignore HTTP date form for determinism and simplicity
  return defaultBackoffMs
}

/**
 * attempt to decode error payload as json then fall back to text
 * keeps output bounded
 */
async function safePayload(res: Response): Promise<ErrorPayload | string> {
  const ct = (res.headers.get("content-type") || "").toLowerCase()
  try {
    if (ct.includes("application/json")) {
      const json = await res.json()
      const parsed = ErrorPayloadSchema.safeParse(json)
      return parsed.success ? parsed.data : safeText(JSON.stringify(json))
    }
    return safeText(await res.text())
  } catch {
    return "unparseable error payload"
  }
}

/**
 * delay helper with deterministic timing
 */
function delay(ms: number): Promise<void> {
  return new Promise((r) => setTimeout(r, ms))
}

/**
 * shrink long text to a bounded size with ellipsis
 */
function safeText(text: string, max = 200): string {
  return text.length <= max ? text : text.slice(0, max) + "…"
}

/**
 * detect common network like errors from fetch
 */
function isNetworkLikeError(err: unknown): boolean {
  if (!err || typeof err !== "object") return false
  const name = (err as any).name as string | undefined
  return name === "AbortError" || name === "TypeError" || name === "FetchError"
}

/**
 * convenience wrapper to POST with JSON body and optional custom schema
 */
export async function postSecureData<T extends z.ZodTypeAny = typeof SecureDataResponseSchema>(
  path: string,
  body: unknown,
  options: Omit<FetchSecureDataOptions, "path" | "method" | "body"> & { expectedSchema?: T } = {}
): Promise<z.infer<T>> {
  const parsed = await fetchSecureData({
    ...options,
    path,
    method: "POST",
    body,
    expectedSchema: (options.expectedSchema ?? SecureDataResponseSchema) as T,
  })
  return parsed as unknown as z.infer<T>
}

/**
 * convenience wrapper to GET with query params and optional custom schema
 */
export async function getSecureData<T extends z.ZodTypeAny = typeof SecureDataResponseSchema>(
  path: string,
  query?: FetchSecureDataOptions["query"],
  options: Omit<FetchSecureDataOptions, "path" | "method" | "query"> & { expectedSchema?: T } = {}
): Promise<z.infer<T>> {
  const parsed = await fetchSecureData({
    ...options,
    path,
    method: "GET",
    query,
    expectedSchema: (options.expectedSchema ?? SecureDataResponseSchema) as T,
  })
  return parsed as unknown as z.infer<T>
}
