// ely_api_client.ts
import { SECRET_KEY, API_TOKEN } from "./config"
import { z } from "zod"

/**
 * Interface for the shape of the API response.
 */
export interface SecureDataResponse {
  data: Record<string, unknown>
  timestamp: string
}

/**
 * Runtime schema validation (strict, no extra keys required)
 */
const SecureDataResponseSchema = z.object({
  data: z.record(z.unknown()),
  timestamp: z.string().refine((s) => !Number.isNaN(Date.parse(s)), "timestamp must be ISO-8601"),
})

/**
 * Options for fetching from Alyssium secure API
 */
export interface FetchSecureDataOptions {
  /** Override base URL; defaults to https://api.alyssium.ai */
  baseUrl?: string
  /** Endpoint path; defaults to /data */
  path?: string
  /** Timeout per attempt in ms; defaults to 10_000 */
  timeoutMs?: number
  /** Number of retries on 429/5xx and network errors; defaults to 2 (total 3 attempts) */
  retries?: number
  /** Deterministic linear backoff (ms) between retries; defaults to 500 */
  backoffMs?: number
  /** Abort an in-flight request (will be composed with internal timeout) */
  signal?: AbortSignal
  /** Extra headers to merge (won’t overwrite auth headers) */
  extraHeaders?: Record<string, string>
}

/**
 * Fetch JSON from the Alyssium secure API with timeout, retries, and schema validation.
 *
 * - Deterministic retries on 429/5xx and network/timeout errors (no randomness)
 * - Strict runtime validation using Zod
 * - Never logs secrets
 */
export async function fetchSecureData(opts: FetchSecureDataOptions = {}): Promise<SecureDataResponse> {
  const {
    baseUrl = "https://api.alyssium.ai",
    path = "/data",
    timeoutMs = 10_000,
    retries = 2,
    backoffMs = 500,
    signal: externalSignal,
    extraHeaders = {},
  } = opts

  const url = new URL(path, baseUrl).toString()

  // deterministic retry loop
  let lastError: unknown
  for (let attempt = 0; attempt <= retries; attempt++) {
    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs)

    // compose external signal with our timeout controller
    const onAbort = () => controller.abort()
    externalSignal?.addEventListener("abort", onAbort, { once: true })

    try {
      const res = await fetch(url, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          "X-API-TOKEN": API_TOKEN,
          "X-SECRET-KEY": SECRET_KEY,
          ...extraHeaders,
        },
        signal: controller.signal,
      })

      // Retry on 429/5xx
      if (res.status === 429 || (res.status >= 500 && res.status <= 599)) {
        lastError = new Error(`Upstream error ${res.status}`)
        if (attempt < retries) {
          await delay(backoffMs * (attempt + 1))
          continue
        }
        throw lastError
      }

      if (!res.ok) {
        const text = safeText(await res.text())
        throw new Error(`API error ${res.status}: ${text}`)
      }

      const contentType = (res.headers.get("content-type") || "").toLowerCase()
      if (!contentType.includes("application/json")) {
        throw new Error(`Unexpected content-type: ${contentType || "unknown"}`)
      }

      const json = (await res.json()) as unknown
      const parsed = SecureDataResponseSchema.parse(json)
      return parsed
    } catch (err: any) {
      lastError = err?.name === "AbortError"
        ? new Error(`Request timed out after ${timeoutMs}ms`)
        : err

      // Only retry on network/timeout errors
      if (attempt < retries && (err?.name === "AbortError" || isNetworkLikeError(err))) {
        await delay(backoffMs * (attempt + 1))
        continue
      }

      // Do not log secrets; log minimal diagnostics if desired
      // console.error("[ely_api_client] fetchSecureData error:", String(lastError))
      throw lastError
    } finally {
      clearTimeout(timeoutId)
      externalSignal?.removeEventListener("abort", onAbort)
    }
  }

  // Should never get here due to throws in loop
  throw lastError ?? new Error("Unknown error")
}

// ----------------- helpers -----------------

function delay(ms: number): Promise<void> {
  return new Promise((r) => setTimeout(r, ms))
}

function safeText(text: string, max = 200): string {
  // avoid flooding logs; keep it deterministic and bounded
  return text.length <= max ? text : text.slice(0, max) + "…"
}

function isNetworkLikeError(err: unknown): boolean {
  if (!err || typeof err !== "object") return false
  const name = (err as any).name as string | undefined
  // Common fetch/network errors across runtimes
  return name === "AbortError" || name === "TypeError" || name === "FetchError"
}
