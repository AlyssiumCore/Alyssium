// ely_api_client.ts
import { SECRET_KEY, API_TOKEN } from './config'

/**
 * Interface for the shape of the API response.
 */
export interface SecureDataResponse {
  data: Record<string, any>
  timestamp: string
}

/**
 * Fetch JSON from the Alyssium secure API with timeout and error handling.
 *
 * @param timeoutMs - Maximum time to wait for a response (in milliseconds)
 * @returns Promise resolving to SecureDataResponse
 * @throws Error if the request fails or times out
 */
export async function fetchSecureData(timeoutMs: number = 10000): Promise<SecureDataResponse> {
  const controller = new AbortController()
  const timeout = setTimeout(() => controller.abort(), timeoutMs)

  try {
    const res = await fetch('https://api.alyssium.ai/data', {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'X-API-TOKEN': API_TOKEN,
        'X-SECRET-KEY': SECRET_KEY,
      },
      signal: controller.signal,
    })

    if (!res.ok) {
      const text = await res.text()
      throw new Error(`API error ${res.status}: ${text}`)
    }

    const json: unknown = await res.json()
    clearTimeout(timeout)

    // Basic runtime validation
    if (
      typeof json === 'object' &&
      json !== null &&
      'data' in json &&
      'timestamp' in json
    ) {
      return json as SecureDataResponse
    } else {
      throw new Error('Unexpected API response shape')
    }
  } catch (err: any) {
    if (err.name === 'AbortError') {
      throw new Error(`Request timed out after ${timeoutMs}ms`)
    }
    console.error('[ely_api_client] fetchSecureData error:', err)
    throw err
  } finally {
    clearTimeout(timeout)
  }
}
